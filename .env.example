# ============================================
# XRPL Vault - Environment Configuration
# ============================================
# Скопируйте этот файл в .env и настройте значения

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_PASSWORD=dev_password_change_me
DATABASE_URL=postgres://xrpl_vault:dev_password_change_me@localhost:5432/xrpl_vault

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# XRPL Network
# ============================================
# Testnet (для разработки)
# Desktop/WebSocket endpoint for submit/account flows.
XRPL_NODE_URL=wss://s.altnet.rippletest.net:51233
# Oracle HTTP JSON-RPC endpoint for ledger verification.
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
XRPL_NETWORK=testnet

# Mainnet (для продакшена)
# XRPL_NODE_URL=wss://xrplcluster.com
# XRPL_RPC_URL=https://xrplcluster.com
# XRPL_NETWORK=mainnet

# ============================================
# Oracle Server
# ============================================
ORACLE_HOST=0.0.0.0
ORACLE_PORT=3000
ORACLE_SECRET_KEY=generate_a_secure_random_key_here

# JWT настройки
JWT_SECRET=another_secure_random_key
JWT_EXPIRATION_HOURS=24

# ============================================
# Storage
# ============================================
# Минимальное количество реплик фрагмента
MIN_REPLICATION_FACTOR=2

# Размер фрагмента в байтах (1MB)
FRAGMENT_SIZE_BYTES=1048576

# ============================================
# Rate Limiting
# ============================================
# Запросов в минуту на пользователя
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================
# Logging
# ============================================
RUST_LOG=oracle=debug,tower_http=debug,sqlx=warn

# ============================================
# Xaman (ранее XUMM) Integration
# ============================================
XAMAN_API_KEY=your_xaman_api_key
XAMAN_API_SECRET=your_xaman_api_secret
